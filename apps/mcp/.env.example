# Copy to .env.local (gitignored). Without ZERNIO_API_KEY the server runs on fixtures (mock mode).
# Every request needs this token, in the URL (/mcp/<token>) or as a Bearer header. openssl rand -hex 20
MCP_TOKEN=change-me-to-a-long-random-string
# Prefer a profile-scoped, expiring Zernio key (https://docs.zernio.com).
ZERNIO_API_KEY=
ZERNIO_PROFILE_ID=
# Set to 1 to let publish_post publish for real.
MCP_ALLOW_PUBLISH=
# Set to 1 only if a host can't call app-only tools: makes publish_post visible to the model too.
MCP_PUBLISH_MODEL_VISIBLE=
# Set to 1 to return clearly labelled sample analytics when the profile has no history yet.
MCP_SAMPLE_ANALYTICS_WHEN_EMPTY=
