# apps/web: copy to apps/web/.env.local (gitignored). Server-side only; never exposed to the browser.
# Without ZERNIO_API_KEY everything runs on fixtures (mock mode), so previews and forks always work.
# Prefer a profile-scoped, expiring Zernio key (https://docs.zernio.com).
ZERNIO_API_KEY=
# Defaults to https://zernio.com/api
ZERNIO_BASE_URL=https://zernio.com/api
# 1 forces fixtures even with a key
ZERNIO_MOCK=
# The Zernio profile the demo acts on in live mode
ZERNIO_DEMO_PROFILE_ID=
# Live mode on a public deployment is owner-only: open /api/demo/unlock?key=<secret> once.
# Public visitors always get fixtures. Generate with: openssl rand -hex 16
ZERNIO_DEMO_SECRET=
# /compose live generation (optional; without these it shows example specs)
ANTHROPIC_API_KEY=
# or AI_GATEWAY_API_KEY= / COMPOSE_USE_GATEWAY=1 (+ COMPOSE_MODEL=) on Vercel

# apps/mcp has its own example: apps/mcp/.env.example
