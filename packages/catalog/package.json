{
  "name": "@zernio-elements/catalog",
  "version": "0.0.1",
  "description": "json-render catalog of Zernio Elements: generative UI built only from tested components.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts"
  },
  "scripts": {
