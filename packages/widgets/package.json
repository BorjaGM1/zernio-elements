{
  "name": "@zernio-elements/widgets",
  "version": "0.0.1",
  "description": "MCP App widgets (preview + approval, analytics, accounts) bundled to single-file HTML for ui:// resources.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/core": "^2.4.0",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.90.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@zernio-elements/catalog": "workspace:*",
    "@zernio-elements/react": "workspace:*",
    "@zernio-elements/rules": "workspace:*",
    "playwright": "^1.65.0",
    "preact": "^10.29.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "vite": "^8.3.7",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^4.1.12",
    "zod": "^4.2.0"
  }
}
